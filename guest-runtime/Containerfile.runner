# Guest runner image (one container per guest; see docs/ARCHITECTURE.md).
# Placeholders only: pin real digests/versions before building.
#
#   podman build -f guest-runtime/Containerfile.runner \
#     --build-arg BASE_IMAGE=<pinned-base-image@sha256:...> \
#     --build-arg OMNIGENT_VERSION=<pinned-omnigent-version> \
#     -t localhost/kurisu-guest-runner:<tag> guest-runtime
#
# The image contains the Omnigent runner, Pi/Node and the relay. It contains no
# credential. At run time it gets --network=none; its only egress is the two
# Unix sockets mounted read-only at /run/kurisu-io (see instance.runner_plan).
ARG BASE_IMAGE=__REQUIRED__
FROM ${BASE_IMAGE}
ARG OMNIGENT_VERSION=__REQUIRED__
RUN python3 -m pip install --no-cache-dir "omnigent==${OMNIGENT_VERSION}"
COPY instance-relay.py /opt/kurisu/instance-relay.py
RUN useradd --create-home --home-dir /home/guest --uid 1000 guest || true
USER guest
WORKDIR /workspace
