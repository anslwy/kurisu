# Kurisu guest image (rootless Podman). NOT BUILT in this workspace.
#
#   podman build -t kurisu/guest:1.0.0 -f guest-runtime/Containerfile .
#
# Design notes:
#  * The container is used read-only by the broker (`podman run --read-only`),
#    with only the guest workspace and a size-limited /tmp writable.
#  * It contains no credentials. The Google tokens stay in the broker; the model
#    is reached through the broker's allowlisting Unix-socket proxy.
#  * python3 is required for the in-container rlimit helper (guest-exec.py) and
#    the loopback model shim (model-shim.py).
#  * Pin the base image by digest for a real deployment.
FROM docker.io/library/node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    PI_OFFLINE=1 \
    PI_SKIP_VERSION_CHECK=1 \
    PI_TELEMETRY=0 \
    LANG=C.UTF-8

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && npm install --global @earendil-works/pi-coding-agent@1.5.0 \
 && npm cache clean --force

# Helper scripts are bind-mounted by the broker, but shipping them makes the
# image usable on its own and keeps `podman run` argv short for debugging.
COPY guest-runtime/guest-exec.py /opt/kurisu/guest-exec.py
COPY guest-runtime/model-shim.py /opt/kurisu/model-shim.py

# The guest's Pi configuration is generated per user inside the workspace
# (single fixed model). Nothing is baked in here on purpose.
RUN mkdir -p /opt/kurisu \
 && useradd --create-home --uid 1000 guest \
 && chown -R guest:guest /opt/kurisu

USER guest
WORKDIR /home/guest

# Default command is replaced by the broker on every turn.
CMD ["pi", "--help"]
