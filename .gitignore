# ---- runtime state: never commit ----
runtime/
state/
*.state.json
*.session.db
audit/
logs/
*.log

# WhatsApp / whatsmeow credentials and device store (CRITICAL)
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
store/
wa-store/
whatsapp-store/
*.json.gob
keys/
qr*.png

# local config with real values (only *.example.* is committed)
config/*.local.yaml
config/*.local.json
config/local/
.env
.env.*
!.env.example

# toolchains downloaded for local builds
.toolchain/

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# go
**/whatsmeow-gateway/bin/
**/whatsmeow-gateway/vendor/

# rust
/target/

# web UI: node_modules ignored; the built dist IS committed (embedded in the binary)
node_modules/
!crates/kurisu/web/dist/
!crates/kurisu/web/dist/**

# Browser test output
crates/kurisu/web/test-results/
crates/kurisu/web/playwright-report/
